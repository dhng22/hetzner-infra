#!/usr/bin/env bash
# =============================================================================
# stack-deploy — redeploy one of the three INFRASTRUCTURE stacks.
# =============================================================================
#   stack-deploy monitoring
#   stack-deploy ingress
#   stack-deploy admin
#
# These three are the cluster itself: metrics, the tunnel connector, and the
# console. They hold no live state that anything else owns, so re-applying the
# file is always safe and always correct.
#
# Applications and databases are NOT stacks in this sense and are not handled
# here. Each component owns its own stack, whose replica count belongs to the
# autoscaler and whose image belongs to CI, so it is deployed by `component
# deploy <name>` — which reads both back from the running service and pins them
# for the deploy. Routing a component through this script would reset it to
# whatever its spec file last said (docker/cli#2235).
#
# `docker stack deploy` interpolates ${VAR} from the environment itself, so
# sourcing infra.env is all the rendering these need.
# =============================================================================

set -euo pipefail

INFRA_DIR="${INFRA_DIR:-/opt/infra}"
INFRA_ENV="${INFRA_ENV:-/etc/infra/infra.env}"
# Generated from infra.env on every monitoring deploy; the path is shared with
# stacks/monitoring.yml, which mounts it as the autoscaler's env_file.
FLEET_ENV="${FLEET_ENV:-/etc/infra/fleet.env}"

die() { echo "error: $*" >&2; exit 1; }

stack="${1:-}"
case "$stack" in
  monitoring|ingress|admin) ;;
  "")  die "usage: stack-deploy <monitoring|ingress|admin>" ;;
  *)   die "'$stack' is not an infrastructure stack. If it is a component, use: component deploy $stack" ;;
esac

[ -f "$INFRA_ENV" ] || die "$INFRA_ENV not found (run this on the master)"
set -a; . "$INFRA_ENV"; set +a

# MASTER_PRIVATE_IP is appended to infra.env by bootstrap and is referenced by
# every stack's loki log driver. Without it the driver silently points at
# http://:3100 and every container's logs vanish.
[ -n "${MASTER_PRIVATE_IP:-}" ] || die "MASTER_PRIVATE_IP is not set in $INFRA_ENV"

# --- which images this cluster is supposed to be running ---------------------
# `monitoring` and `admin` name ${INFRA_IMAGE_*} rather than a tag, and those
# are resolved here from the commit bin/infra-update last applied. Doing it in
# ONE place is the point: the panel redeploys monitoring when you save a
# setting, and if that path resolved the image differently from the updater's
# path, saving a setting would quietly move the cluster to another version of
# the autoscaler.
#
# `ingress` is deliberately not in this list — it runs cloudflared's published
# image and nothing this repository builds, so a cluster with no recorded
# commit can still redeploy its tunnel.
case "$stack" in
  monitoring|admin)
    . "$INFRA_DIR/bin/infra-images"
    infra_images || die "cannot resolve the infrastructure image references (see above)"
    echo "images pinned to ${INFRA_IMAGE_COMMIT:0:12}"
    ;;
esac

# --- rendering ---------------------------------------------------------------
# The monitoring stack mounts two generated files, so they are regenerated HERE
# rather than only at boot. That is what makes the panel's Settings page work:
# changing the alert destination writes infra.env and redeploys monitoring, and
# the config it mounts has to be rebuilt in between. Doing it only in bootstrap
# meant an edit appeared to save and changed nothing until the next rebuild.
if [ "$stack" = "monitoring" ]; then
  envsubst < "$INFRA_DIR/config/vmagent.yml.tpl" > "$INFRA_DIR/config/vmagent.yml"

  # The autoscaler's settings, as a file the stack can point `env_file` at.
  # Generated rather than stored for the same reason as the two configs around
  # it: infra.env is written once at boot and never gains a key, so a setting
  # added later has to be filled in from the repo's defaults here. This is also
  # what keeps the stack file out of it — it names fleet.env, not variables.
  "$INFRA_DIR/bin/render-fleet-env" "$FLEET_ENV" >/dev/null \
    || die "could not render $FLEET_ENV"

  # GENERATED from the target list, not envsubst'd from a template. The template
  # had exactly one destination baked into it — two rows on the Settings page —
  # so you could not have two, could not have none deliberately, and adding
  # Slack meant hand-editing YAML and widening a check here that nothing would
  # have reminded you about. Targets are managed under Alerts > Targets now, and
  # every alert goes to all of them.
  #
  # NO TARGETS is a real state and not an error: the file it writes then drops
  # everything visibly, the stack still comes up, and `smoke-test` reports it.
  "$INFRA_DIR/bin/render-alertmanager" "$INFRA_DIR/config/alertmanager.yml" \
    || die "could not render the alertmanager config"
  # It holds a bot token, so it is not world-readable. Not a docker secret,
  # deliberately: a secret cannot be absent and cannot be changed, and this has
  # to be both optional and editable. Same trade as a component's credentials.
  #
  # 0640 root:65534, NOT 0600 root. prom/alertmanager runs as `nobody` (uid
  # 65534) and this file is a bind mount, so 0600 root meant the container could
  # not read its own config: it exited 1 on "permission denied" and crash-looped
  # from the very first deploy, while every other service came up fine. The
  # group bit is what makes it readable to that one process; the file is still
  # closed to everything else on the host, which is the property that mattered.
  #
  # The gid is coupled to the image. If alertmanager's uid ever changes, this
  # breaks the same silent way — check `docker image inspect ... .Config.User`
  # when bumping the pin in stacks/monitoring.yml.
  chown 0:65534 "$INFRA_DIR/config/alertmanager.yml"
  chmod 640 "$INFRA_DIR/config/alertmanager.yml"

  # WHAT MAKES THE NEW CONFIG ACTUALLY RUN.
  #
  # Swarm restarts a task when its SPEC changes, and a bind-mounted file is not
  # part of the spec. So rendering a new alertmanager.yml and running `docker
  # stack deploy` was a no-op for the one service that had to notice: the file
  # on disk was correct, `docker service inspect` was correct, and the process
  # went on serving the config it read at startup. Alerting was pointed at a
  # destination that had been replaced days earlier, and every surface a person
  # would check to find that out agreed with the change rather than with the
  # process.
  #
  # Putting the config's own digest in the environment makes the spec change
  # exactly when the config does, so the task rolls when — and only when —
  # there is something new to read.
  ALERTMANAGER_CONFIG_SHA="$(sha256sum "$INFRA_DIR/config/alertmanager.yml" \
    | cut -c1-16)"
  export ALERTMANAGER_CONFIG_SHA
fi

echo "deploying $stack"
docker stack deploy --with-registry-auth -c "$INFRA_DIR/stacks/$stack.yml" "$stack"
