#!/usr/bin/env bash
# =============================================================================
# panel-hostops — the ONLY thing the admin panel can run on the host.
# =============================================================================
# The panel needs to change the firewall, which lives on the host and cannot be
# reached through the docker socket. So bootstrap gives it an SSH key, and this
# script is pinned as that key's forced command in root's authorized_keys:
#
#   command="/opt/infra/bin/panel-hostops",restrict ssh-ed25519 AAAA...
#
# `command=` means the client cannot choose what runs — whatever it asks for
# arrives in SSH_ORIGINAL_COMMAND and this script decides. `restrict` disables
# port forwarding, agent forwarding, X11 and PTY allocation.
#
# So the panel does NOT have root shell on the master. It has exactly the verbs
# below, with arguments it cannot smuggle anything through: ports are matched
# against ^[0-9]+$ and range-checked before they reach ufw.
#
# Adding a verb here widens what a compromised panel can do to the host. Think
# before you do it, and never add one that takes a free-form string.
# =============================================================================

set -euo pipefail

log() { logger -t panel-hostops -- "$*" 2>/dev/null || true; echo "$*"; }

deny() {
  log "REFUSED: ${SSH_ORIGINAL_COMMAND:-<empty>}"
  echo "refused: the admin panel may only run: ufw-deny <port>, ufw-status, repo-check" >&2
  exit 2
}

read -r -a argv <<< "${SSH_ORIGINAL_COMMAND:-}"
verb="${argv[0]:-}"
arg="${argv[1]:-}"

valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] || return 1
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ] || return 1
  # 22 is how you get back in if the panel is ever wrong. Never let it be closed.
  [ "$1" -ne 22 ] || return 1
}

case "$verb" in
  # NO `ufw-allow`, and it was removed rather than never added. Databases are
  # reached through the Cloudflare tunnel now — the connector dials out, nothing
  # is published on a host interface — so there is no longer anything the panel
  # needs a hole in this firewall for. Closing stays, for the rule an older
  # cluster opened for a published database port; that port now has nothing
  # behind it, and an open port with nothing behind it is what nobody finds
  # again. Do not put this back without a reason as good as the one that took
  # it out.
  ufw-deny)
    valid_port "$arg" || deny
    log "ufw delete allow ${arg}/tcp"
    # `delete allow` removes the rule; absent rules are not an error worth failing on.
    ufw delete allow "${arg}/tcp" || true
    ;;
  ufw-status)
    ufw status numbered
    ;;
  # Ask the updater whether it can still reach the repo, and change nothing.
  #
  # NO ARGUMENT — the URL comes from /etc/infra/infra.env, which the panel
  # already writes through its own bind mount, so this verb smuggles nothing in
  # and widens a compromised panel's reach by exactly one `git ls-remote`.
  #
  # It exists because the panel has no git binary and, more to the point, must
  # not be the thing that decides whether a credential works: the answer has to
  # come from the process that will actually be doing the pulling, in the
  # environment it will be doing it in. `--check` stops before any change.
  repo-check)
    [ -x /opt/infra/bin/infra-update ] || { echo "infra-update is not installed" >&2; exit 3; }
    /opt/infra/bin/infra-update --check
    ;;
  *)
    deny
    ;;
esac
