#!/usr/bin/env bash
# =============================================================================
# infra-update — bring this master's /opt/infra up to the repo's newest commit.
# =============================================================================
#   infra-update            # update if the remote has moved
#   infra-update --check    # say what would happen, change nothing
#   infra-update --force    # re-apply the current commit anyway
#
# THE REPO IS THE SOURCE OF TRUTH. Without this, the only way to change a
# running cluster's infrastructure was to copy files onto the master by hand —
# so the box and the repo drifted apart silently, and "what is actually running"
# stopped being a question git could answer.
#
# Run from a systemd timer (bootstrap installs one). Deliberately NOT run from
# inside the admin panel: this updates the panel, and a container cannot
# redeploy itself and still be around to report how it went.
#
# WHAT IT DOES NOT TOUCH
#   /etc/infra/infra.env        per-cluster configuration, never in the repo
#   $INFRA_DIR/components/      your components, created at runtime
#   $INFRA_DIR/state/           deploy tokens and history
#   docker secrets              immutable, and bootstrap's job
#
# It is not bootstrap. Bootstrap does the one-time things — swarm init, secrets,
# the firewall — and must never run twice. This only refreshes files, pulls the
# images GitHub Actions published for the new commit, and re-applies the three
# infrastructure stacks. Everything it does is idempotent.
#
# IT BUILDS NOTHING. It used to build three images, run four test suites and
# then work out which services Swarm had declined to restart, and every one of
# those was a job that belongs in CI running on the box whose actual job is
# serving the cluster. The images are built and tested by
# .github/workflows/publish.yml and tagged with the commit they came from, so
# this script pulls one exact reference per service and lets Swarm do the
# rollout it was designed to do.
# =============================================================================

set -euo pipefail

INFRA_DIR="${INFRA_DIR:-/opt/infra}"
INFRA_ENV="${INFRA_ENV:-/etc/infra/infra.env}"
STATE_DIR="$INFRA_DIR/state"
# One JSON file rather than a bare SHA, because the panel has to answer three
# separate questions and only one of them is "which commit": an update that
# stopped happening looks identical to an up-to-date cluster unless you can also
# see when it last managed to CHECK.
VERSION_FILE="$STATE_DIR/version.json"
LOCK_FILE=/var/run/infra-update.lock

MODE=apply
case "${1:-}" in
  --check) MODE=check ;;
  --force) MODE=force ;;
  "")      ;;
  *)       echo "usage: infra-update [--check|--force]" >&2; exit 2 ;;
esac

log() { printf '%s %s\n' "$(date -Is)" "$*"; }

# A timer job has no terminal, so a git that decides it wants a password has
# nowhere to ask and nothing to wait for. Without this it still fails, but it
# fails after libcurl has retried, and by a route that reads like a network
# problem rather than a credential one. Say it up front instead.
export GIT_TERMINAL_PROMPT=0

#: Anything git said, with the credentials taken back out of it.
#: git names the URL it failed on, and that URL carries the token — so passing
#: git's own words through untouched is how the repo credential ends up in
#: journald and in the tooltip the panel prints. (The token is still visible in
#: this process's argv to a root that goes looking; /etc/infra/infra.env is
#: root-only, so that is the same audience.)
redact() {
    sed -e 's#://[^/@[:space:]]*@#://***@#g' \
        -e 's#gh[pousr]_[A-Za-z0-9]\{16,\}#***#g' \
        -e 's#github_pat_[A-Za-z0-9_]\{16,\}#***#g'
}

#: git's complaint, redacted and squashed to one line the panel can print.
why() { printf '%s' "$1" | redact | tr '\n' ' ' | cut -c1-220; }

#: Read one field out of the state file, or "" if it is absent or unreadable.
state_get() {
    python3 - "$VERSION_FILE" "$1" <<'PYEOF' 2>/dev/null || true
import json, sys
try:
    print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")
except Exception:
    print("")
PYEOF
}

#: Rewrite the state file, merging the given key=value pairs over what is there.
#: Written on EVERY run including the ones that change nothing — `checked_at` is
#: how you tell a cluster that is up to date from one whose updater has been
#: dead for a week, and those look the same from the commit alone.
state_set() {
    mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
    python3 - "$VERSION_FILE" "$@" <<'PYEOF'
import json, sys
path, pairs = sys.argv[1], sys.argv[2:]
try:
    data = json.load(open(path))
except Exception:
    data = {}
for pair in pairs:
    key, _, value = pair.partition("=")
    data[key] = value
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh, indent=2)
import os
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PYEOF
}

die() {
    log "ERROR: $*"
    state_set "status=error" "detail=$*" "checked_at=$(date -Is)"
    exit 1
}

# One at a time. A timer firing while a rebuild is still running would race two
# `docker stack deploy`s against the same stack.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "another infra-update is already running; skipping this tick"
  exit 0
fi

[ -f "$INFRA_ENV" ] || die "$INFRA_ENV not found (run this on the master)"
set -a; . "$INFRA_ENV"; set +a

# Opt-in. A cluster with no repo configured is a valid state — it was built from
# a bundle somebody copied in — so say so once and stop, rather than failing.
case "${INFRA_REPO_URL:-}" in
  ""|*REPLACE_ME*)
    log "INFRA_REPO_URL is not set in $INFRA_ENV — this cluster does not self-update."
    exit 0
    ;;
esac
BRANCH="${INFRA_REPO_BRANCH:-master}"

# A token pasted in as `https://TOKEN@github.com/...` is userinfo with no
# password, and git reads it as a USERNAME. So git makes the request with no
# credential at all, takes the 401, and then asks for a password that no timer
# job has anywhere to read from — which is how a perfectly good token produces
# "could not read Password". GitHub wants the token as the PASSWORD, under any
# username at all.
#
# Rewritten here rather than by asking for a different string in infra.env,
# because the string people are given to paste is the token. Anything that
# already carries a colon is somebody's deliberate `user:secret` and is left
# exactly as it is, as is any scheme that is not http(s).
case "$INFRA_REPO_URL" in
  http://*|https://*)
    _rest="${INFRA_REPO_URL#*://}"
    case "${_rest%%/*}" in
      *@*)
        case "${_rest%%@*}" in
          *:*) ;;
          *) INFRA_REPO_URL="${INFRA_REPO_URL%%://*}://x-access-token:${_rest}" ;;
        esac
        ;;
    esac
    ;;
esac

# --- what is running, and what is upstream -----------------------------------
running="$(state_get commit)"

# ls-remote rather than a clone: one request, no working tree, and it is the
# only thing that needs to happen on a tick where nothing has changed. A poll
# that cloned the repo every minute would be a poll nobody left switched on.
#
# git's stderr is CAPTURED rather than discarded. "cannot reach the repo" was
# the only thing this could ever say, so an expired token, a renamed branch and
# a dead network all produced the same sentence — and the one that actually
# happened (a token GitHub answers "Bad credentials" to) is the one that
# sentence sends you looking in the wrong place for.
if ! ls_remote="$(git ls-remote "$INFRA_REPO_URL" "refs/heads/$BRANCH" 2>&1)"; then
  die "cannot reach the repo: $(why "$ls_remote")"
fi
remote="$(printf '%s\n' "$ls_remote" | awk 'NR==1{print $1}')"
[ -n "$remote" ] || die "branch '$BRANCH' does not exist in the repo"

# READ BEFORE WRITING. The commit is recorded BEFORE the deploys, so a run that
# fails after that point leaves `commit == remote` with `status=error`, and
# without the status test below that state is PERMANENT: every later tick sees
# the commit it wants and exits, so a run that failed once never gets retried
# and the box serves the old code forever while reporting the new SHA.
#
# This read used to sit UNDER the check-in write below, which set `status=ok` on
# every tick — so it always read "ok", the retry never fired, and the guard was
# an elaborate no-op. The check-in write no longer touches `status` or `detail`
# at all: whether the last APPLY worked is not something a poll finds out, and
# overwriting it every five minutes is what destroyed the evidence. Only the end
# of a successful run sets `ok`, and only `die` sets `error`.
last_status="$(state_get status)"

state_set "checked_at=$(date -Is)" "remote=$remote" "branch=$BRANCH"

if [ "$MODE" != "force" ] && [ "$running" = "$remote" ] && [ "$last_status" != "error" ]; then
  [ "$MODE" = "check" ] && log "up to date at ${remote:0:12}"
  exit 0
fi
[ "$last_status" = "error" ] && [ "$running" = "$remote" ] \
  && log "retrying ${remote:0:12} after a failed run: $(state_get detail)"

log "running ${running:0:12}${running:+ ->} upstream ${remote:0:12} on $BRANCH"
if [ "$MODE" = "check" ]; then
  log "--check: stopping before any change"
  exit 0
fi

# --- fetch into a scratch tree, never over the live one ----------------------
# The live tree is only touched once the new one has been checked. A clone that
# fails halfway must not be able to leave the cluster with half a bundle.
work="$(mktemp -d /tmp/infra-update.XXXXXX)"
cleanup() { rm -rf "$work"; }
trap cleanup EXIT

if ! clone_out="$(git clone --quiet --depth 1 --branch "$BRANCH" \
                     "$INFRA_REPO_URL" "$work/repo" 2>&1)"; then
  die "clone failed: $(why "$clone_out")"
fi
got="$(git -C "$work/repo" rev-parse HEAD)"

# The same preflight bootstrap runs, for the same reason: a bundle missing a
# stack file deploys most of a cluster and leaves the rest broken.
#
# THE LIST COMES FROM THE FETCHED TREE, not from this script. A hardcoded list
# means the running version decides what the incoming version must contain, and
# then no file can ever be deleted from this repo again: every cluster refuses
# every future commit, forever, naming a file that was removed on purpose. That
# is not hypothetical — renaming config/alertmanager.yml.tpl to
# bin/render-alertmanager stranded a live master for two days, five minutes at a
# time, while `docker service ls` showed everything healthy.
#
# The fallback is this script's own list, for a tree old enough not to carry one.
# It is deliberately the SHORT list: the fallback exists to keep an old tree
# deployable, not to second-guess a new one.
manifest="$work/repo/config/required-files"
if [ -f "$manifest" ]; then
  required_files="$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$manifest")"
else
  required_files="stacks/monitoring.yml stacks/ingress.yml stacks/admin.yml
config/vmagent.yml.tpl config/alerts.yml bin/component bin/stack-deploy
bin/infra-update bin/infra-images"
fi
for required in $required_files; do
  [ -e "$work/repo/$required" ] || die "the fetched tree is missing $required — refusing to apply it"
done

# --- what changed, for the one decision that still depends on it -------------
# Compared by content rather than by `git diff`, because the live tree is not a
# checkout: it carries config rendered by stack-deploy and bytecode left by a
# test run, and comparing those would report a difference on every single tick.
# The exclusions mirror rsync's below; a file skipped by one and compared by the
# other is a permanent phantom change.
DIFF_SKIP=(-x 'vmagent.yml' -x 'alertmanager.yml' -x 'worker-cloud-init.yaml'
           -x '__pycache__' -x '*.pyc' -x '.git')

changed() {
  local area="$1"
  [ -e "$INFRA_DIR/$area" ] || return 0          # new area counts as changed
  ! diff -qr --no-dereference "${DIFF_SKIP[@]}" \
      "$INFRA_DIR/$area" "$work/repo/$area" >/dev/null 2>&1
}

# The only thing left that has to be decided rather than just done. vmagent and
# vmalert read their config from a BIND MOUNT, so a changed file is invisible to
# the service spec: Swarm has nothing to update and the old config stays loaded.
# Those two need telling, and only when the file actually moved.
config_changed=false
changed config && config_changed=true

# --- the images for this commit, and whether they exist yet ------------------
# Sourced from the FETCHED tree, not the live one: this is the new commit's idea
# of where its own images live, and it is read before anything is copied over.
. "$work/repo/bin/infra-images"
infra_images "$got" || die "cannot work out which images ${got:0:12} should run (see above)"

# Pulling IS the check. A published commit pulls; an unpublished one does not,
# and the reason — still building, build failed, registry credentials expired —
# arrives in the error rather than being guessed at here.
#
# This happens BEFORE the files are swapped in, so a commit whose images are not
# ready leaves the cluster exactly as it was rather than half-applied. The next
# tick tries again, because `running` still differs from `remote`.
pull_error=""
for ref in $(infra_image_refs); do
  log "pulling $ref"
  out="$(docker pull --quiet "$ref" 2>&1)" || { pull_error="$ref: $out"; break; }
done

if [ -n "$pull_error" ]; then
  # A wait and a failure look identical for the first minute or two — CI takes
  # a couple of minutes to publish — so the difference is drawn in TIME rather
  # than guessed from the error text. Below the deadline this is a quiet
  # "pending"; above it, the panel says the update is failing and says why,
  # because a cluster stuck at a commit with no images and no visible reason is
  # the exact silent failure this whole file keeps being rewritten to remove.
  since="$(state_get waiting_since)"
  [ -n "$since" ] || since="$(date -Is)"
  waited=$(( $(date +%s) - $(date -d "$since" +%s 2>/dev/null || date +%s) ))
  state_set "waiting_since=$since"
  if [ "$waited" -lt "${INFRA_IMAGE_WAIT_SECONDS:-1500}" ]; then
    log "images for ${got:0:12} are not published yet; waiting ($((waited / 60))m so far)"
    state_set "status=waiting" \
              "detail=waiting for GitHub Actions to publish the images for ${got:0:12}"
    exit 0
  fi
  die "no images for ${got:0:12} after $((waited / 60)) minutes. The build for this commit probably failed — check the repository's Actions tab. Last error: $pull_error"
fi
state_set "waiting_since="

# --- swap the files in -------------------------------------------------------
# rsync with --delete so a file REMOVED upstream is removed here too; `cp -a`
# only ever adds, which leaves a deleted stack or a renamed script behind to be
# found months later. The excludes are the runtime state that is this cluster's
# and not the repo's — deleting those would take your components with them.
#
# The runtime excludes are ANCHORED with a leading slash, and that slash is
# load-bearing. An rsync pattern without one matches a directory of that name at
# ANY depth: `components/` was meant to protect `/opt/infra/components/` — your
# component specs, which the repo must never overwrite — and it silently also
# matched `/opt/infra/admin/components/`, the component CLASS LIBRARY, which is
# repo code and has to ship. The panel then built from a frozen copy of that
# package forever, while every other file in `admin/` updated normally and the
# updater reported success.
#
# Compared BEFORE the copy, because the copy is what destroys the evidence.
self_changed=false
if ! diff -q "$INFRA_DIR/bin/infra-update" "$work/repo/bin/infra-update" >/dev/null 2>&1; then
  self_changed=true
fi

rsync -a --delete \
  --exclude '.git' \
  --exclude '/components/' \
  --exclude '/state/' \
  --exclude 'config/vmagent.yml' \
  --exclude 'config/alertmanager.yml' \
  --exclude 'config/worker-cloud-init.yaml' \
  "$work/repo/" "$INFRA_DIR/"

# Did the copy actually deliver the code? The excludes above are the one thing
# in this script that can decline to copy a file and report success, and when
# one of them over-matches the result is a cluster serving a frozen directory
# forever. Comparing the delivered tree against the fetched one costs a
# directory walk and turns that into a loud failure — before the commit is
# recorded, so the panel shows "update failing" rather than the new SHA. Same
# exclusions as `changed()`, or generated config would fail it every time.
for area in admin autoscaler overseer dataguard signals pki bin stacks config; do
  [ -e "$work/repo/$area" ] || continue
  diff -qr --no-dereference "${DIFF_SKIP[@]}" \
       "$INFRA_DIR/$area" "$work/repo/$area" >/dev/null 2>&1 \
    || die "$area still differs from the fetched tree after rsync — an exclude pattern is swallowing code. Refusing to deploy a stale tree."
done

chmod +x "$INFRA_DIR"/bin/* 2>/dev/null || true

# THE UPDATER UPDATES ITSELF, AND THE RUN THAT DELIVERS A CHANGE IS THE OLD
# VERSION. Everything above this line is generic — fetch, compare, copy — but
# everything below it is specific: which images to pull, which stacks to deploy,
# which services to wait for. A commit that changes any of that arrives here
# already delivered and is then acted on by a script that predates it. That is
# not hypothetical: moving the autoscaler's build context shipped a Dockerfile
# the previous script built from the wrong directory, and the build failed on a
# tree that was otherwise perfectly correct.
#
# So hand over. The replacement re-fetches — one extra clone, only on the ticks
# where this file actually changed — and finds the tree already current, which
# costs nothing but a pull of images that are now in the local store.
if [ -z "${INFRA_UPDATE_RESUMED:-}" ] && [ "$self_changed" = true ]; then
  log "bin/infra-update changed in ${got:0:12}; handing over to the new version"
  case "$MODE" in
    force) INFRA_UPDATE_RESUMED=1 exec "$INFRA_DIR/bin/infra-update" --force ;;
    *)     INFRA_UPDATE_RESUMED=1 exec "$INFRA_DIR/bin/infra-update" ;;
  esac
fi

# Recorded BEFORE the deploys, because the files on disk are already the new
# ones — and because bin/stack-deploy reads this file to work out which image
# tag to deploy. A deploy that fails after this point must not leave the cluster
# claiming to run the commit it no longer has on disk.
state_set "commit=$got" "updated_at=$(date -Is)" "previous=$running"
log "files updated to ${got:0:12}"

# --- redeploy ----------------------------------------------------------------
# All three, unconditionally, and that is a deliberate simplification of what
# used to be four flags and a change-detection matrix. Each infrastructure image
# is now tagged with the commit, so every stack file that names one produces a
# DIFFERENT service spec on every commit and Swarm rolls it. Working out in
# advance which of them would have differed bought nothing except a way to be
# wrong: `docker stack deploy` compares specs itself and leaves a service whose
# spec is unchanged completely alone.
#
# monitoring first: it owns the network the other two declare external, and
# stack-deploy re-renders vmagent.yml, alertmanager.yml and fleet.env on the way
# through. admin LAST, on purpose — it is the console you would use to find out
# that an update went wrong, so it stays up for as much of the update as it can.
log "deploying monitoring"
"$INFRA_DIR/bin/stack-deploy" monitoring >/dev/null || die "monitoring deploy failed"
if [ "$config_changed" = true ]; then
  log "config changed; restarting vmagent and vmalert onto it"
  docker service update --force --quiet "monitoring_vmagent" >/dev/null 2>&1 || true
  docker service update --force --quiet "monitoring_vmalert" >/dev/null 2>&1 || true
fi

# --- services this version has retired ---------------------------------------
# `bin/stack-deploy` runs `docker stack deploy` WITHOUT `--prune` — only a
# component prunes, because a component owns its whole stack and nothing else
# writes to it. The infrastructure stacks are not pruned on purpose: an operator
# who added a service to one by hand should not lose it to an unrelated update.
#
# The cost of that choice is that a RENAMED infrastructure service does not go
# away. `monitoring_dispatcher` became `monitoring_overseer`, and without this
# the old one would keep running forever: still scraped, still holding a CPU and
# memory reservation the capacity arithmetic subtracts from app room, and still
# POSTing stale verdicts at the autoscaler alongside the new process.
#
# So retirements are named, once, and removed idempotently. A name that is
# already gone is not an error.
for retired in monitoring_dispatcher; do
  if docker service inspect "$retired" >/dev/null 2>&1; then
    log "removing $retired (renamed in this version)"
    docker service rm "$retired" >/dev/null 2>&1 || log "could not remove $retired; remove it by hand"
  fi
done

log "deploying ingress"
"$INFRA_DIR/bin/stack-deploy" ingress >/dev/null || die "ingress deploy failed"

log "deploying admin"
"$INFRA_DIR/bin/stack-deploy" admin >/dev/null || die "admin deploy failed"

# --- did the new code actually start? ----------------------------------------
# `docker stack deploy` is DETACHED: it exits 0 once Swarm accepts the spec,
# which is before a single task has started. Taking that exit code as the answer
# is how this script used to report success over a rollout that failed and was
# rolled back — so the question is put to the CONTAINER instead, and the answer
# is the commit label CI baked into the image it was started from.
#
# Asking the container rather than the tag is what makes a missed service loud.
# The overseer was once given a build and no restart, so it rebuilt on every
# tick and never once started, at status ok, for days.
service_commit() {
  local name="$1" cid img
  cid="$(docker ps -q --filter "label=com.docker.swarm.service.name=$name" \
         --filter status=running 2>/dev/null | head -1)"
  [ -n "$cid" ] || { echo ""; return 0; }
  img="$(docker inspect "$cid" -f '{{.Image}}' 2>/dev/null || echo "")"
  [ -n "$img" ] || { echo ""; return 0; }
  docker image inspect "$img" -f '{{index .Config.Labels "infra.commit"}}' 2>/dev/null || echo ""
}

wait_for_commit() {
  local name="$1" want="$2" deadline actual=""
  deadline=$(( $(date +%s) + ${INFRA_ROLLOUT_TIMEOUT_SECONDS:-300} ))
  while :; do
    actual="$(service_commit "$name")"
    [ "$actual" = "$want" ] && { log "$name is running ${want:0:12}"; return 0; }
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep 5
  done
  die "$name did not come up on ${want:0:12} — it is on ${actual:-no running container on this node}. Swarm may have rolled it back. Check: docker service ps --no-trunc $name"
}

for name in monitoring_autoscaler monitoring_overseer monitoring_dataguard admin_ui; do
  wait_for_commit "$name" "$got"
done

state_set "status=ok" "detail="
log "updated to ${got:0:12}"
