#!/usr/bin/env bash
# =============================================================================
# infra-update — bring this master's /opt/infra up to the repo's newest commit.
# =============================================================================
#   infra-update            # update if the remote has moved
#   infra-update --check    # say what would happen, change nothing
#   infra-update --force    # re-apply the current commit anyway
#
# THE REPO IS THE SOURCE OF TRUTH. Without this, the only way to change a
# running cluster's infrastructure was to copy files onto the master by hand —
# so the box and the repo drifted apart silently, and "what is actually running"
# stopped being a question git could answer.
#
# Run from a systemd timer (bootstrap installs one). Deliberately NOT run from
# inside the admin panel: this updates the panel, and a container cannot
# redeploy itself and still be around to report how it went.
#
# WHAT IT DOES NOT TOUCH
#   /etc/infra/infra.env        per-cluster configuration, never in the repo
#   $INFRA_DIR/components/      your components, created at runtime
#   $INFRA_DIR/state/           deploy tokens and history
#   docker secrets              immutable, and bootstrap's job
#
# It is not bootstrap. Bootstrap does the one-time things — swarm init, secrets,
# the firewall — and must never run twice. This only refreshes files, rebuilds
# the two local images when their source changed, and re-applies the three
# infrastructure stacks that changed. Everything it does is idempotent.
# =============================================================================

set -euo pipefail

INFRA_DIR="${INFRA_DIR:-/opt/infra}"
INFRA_ENV="${INFRA_ENV:-/etc/infra/infra.env}"
STATE_DIR="$INFRA_DIR/state"
# One JSON file rather than a bare SHA, because the panel has to answer three
# separate questions and only one of them is "which commit": an update that
# stopped happening looks identical to an up-to-date cluster unless you can also
# see when it last managed to CHECK.
VERSION_FILE="$STATE_DIR/version.json"
LOCK_FILE=/var/run/infra-update.lock

MODE=apply
case "${1:-}" in
  --check) MODE=check ;;
  --force) MODE=force ;;
  "")      ;;
  *)       echo "usage: infra-update [--check|--force]" >&2; exit 2 ;;
esac

log() { printf '%s %s\n' "$(date -Is)" "$*"; }

#: Read one field out of the state file, or "" if it is absent or unreadable.
state_get() {
    python3 - "$VERSION_FILE" "$1" <<'PYEOF' 2>/dev/null || true
import json, sys
try:
    print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")
except Exception:
    print("")
PYEOF
}

#: Rewrite the state file, merging the given key=value pairs over what is there.
#: Written on EVERY run including the ones that change nothing — `checked_at` is
#: how you tell a cluster that is up to date from one whose updater has been
#: dead for a week, and those look the same from the commit alone.
state_set() {
    mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
    python3 - "$VERSION_FILE" "$@" <<'PYEOF'
import json, sys
path, pairs = sys.argv[1], sys.argv[2:]
try:
    data = json.load(open(path))
except Exception:
    data = {}
for pair in pairs:
    key, _, value = pair.partition("=")
    data[key] = value
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh, indent=2)
import os
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PYEOF
}

die() {
    log "ERROR: $*"
    state_set "status=error" "detail=$*" "checked_at=$(date -Is)"
    exit 1
}

# One at a time. A timer firing while a rebuild is still running would race two
# `docker stack deploy`s against the same stack.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "another infra-update is already running; skipping this tick"
  exit 0
fi

[ -f "$INFRA_ENV" ] || die "$INFRA_ENV not found (run this on the master)"
set -a; . "$INFRA_ENV"; set +a

# Opt-in. A cluster with no repo configured is a valid state — it was built from
# a bundle somebody copied in — so say so once and stop, rather than failing.
case "${INFRA_REPO_URL:-}" in
  ""|*REPLACE_ME*)
    log "INFRA_REPO_URL is not set in $INFRA_ENV — this cluster does not self-update."
    exit 0
    ;;
esac
BRANCH="${INFRA_REPO_BRANCH:-master}"

# --- what is running, and what is upstream -----------------------------------
running="$(state_get commit)"

# ls-remote rather than a clone: one request, no working tree, and it is the
# only thing that needs to happen on a tick where nothing has changed. A poll
# that cloned the repo every minute would be a poll nobody left switched on.
remote="$(git ls-remote "$INFRA_REPO_URL" "refs/heads/$BRANCH" 2>/dev/null | awk '{print $1}')" \
  || die "cannot reach the repo. Check INFRA_REPO_URL and the token in it."
[ -n "$remote" ] || die "branch '$BRANCH' does not exist in the repo"

state_set "checked_at=$(date -Is)" "remote=$remote" "branch=$BRANCH" \
          "status=ok" "detail="

if [ "$MODE" != "force" ] && [ "$running" = "$remote" ]; then
  [ "$MODE" = "check" ] && log "up to date at ${remote:0:12}"
  exit 0
fi

log "running ${running:0:12}${running:+ ->} upstream ${remote:0:12} on $BRANCH"
if [ "$MODE" = "check" ]; then
  log "--check: stopping before any change"
  exit 0
fi

# --- fetch into a scratch tree, never over the live one ----------------------
# The live tree is only touched once the new one has been checked. A clone that
# fails halfway must not be able to leave the cluster with half a bundle.
work="$(mktemp -d /tmp/infra-update.XXXXXX)"
cleanup() { rm -rf "$work"; }
trap cleanup EXIT

git clone --quiet --depth 1 --branch "$BRANCH" "$INFRA_REPO_URL" "$work/repo" \
  || die "clone failed"
got="$(git -C "$work/repo" rev-parse HEAD)"

# The same preflight bootstrap runs, for the same reason: a bundle missing a
# stack file deploys most of a cluster and leaves the rest broken.
for required in stacks/monitoring.yml stacks/ingress.yml stacks/admin.yml \
                config/vmagent.yml.tpl config/alertmanager.yml.tpl \
                config/alerts.yml autoscaler/Dockerfile admin/Dockerfile \
                bin/component bin/stack-deploy bin/infra-update \
                bin/render-fleet-env; do
  [ -e "$work/repo/$required" ] || die "the fetched tree is missing $required — refusing to apply it"
done

# --- decide what actually has to be redeployed -------------------------------
# Per area, so an admin-only change does not restart VictoriaMetrics. Compared
# by content rather than by `git diff`, because the live tree is not a checkout:
# it carries generated config and runtime directories that no commit contains.
# The live tree carries things no commit does — config rendered by
# stack-deploy, bytecode left by a test run — and comparing those would report a
# difference on every single tick, so every tick would redeploy monitoring. The
# exclusions mirror rsync's below; a file skipped by one and compared by the
# other is a permanent phantom change.
DIFF_SKIP=(-x 'vmagent.yml' -x 'alertmanager.yml' -x 'worker-cloud-init.yaml'
           -x '__pycache__' -x '*.pyc' -x '.git')

changed() {
  local area="$1"
  [ -e "$INFRA_DIR/$area" ] || return 0          # new area counts as changed
  ! diff -qr --no-dereference "${DIFF_SKIP[@]}" \
      "$INFRA_DIR/$area" "$work/repo/$area" >/dev/null 2>&1
}

# What the RUNNING CONTAINER of a service was built from — which is a stronger
# question than "did the files change", and a stronger one than "what does the
# tag say".
#
# Files alone assume the running image was built from the files on disk, and the
# moment anybody copies something onto the box by hand, or a build fails halfway
# through an earlier run, that stops being true.
#
# The TAG is worse, and asking it is what wedged this script. `:latest` is
# whatever the last build produced, so a run that rebuilt the image and then did
# not restart the service — the normal outcome, since a locally-built tag gives
# Swarm no spec change to act on — leaves the tag carrying the new commit and the
# container carrying the old one. Every later run then reads the tag, concludes
# there is nothing to do, and the cluster stays on the old code permanently, with
# `--force` unable to recover it either. Asking the container is what makes that
# state self-healing.
#
# Empty (service not running, or an unlabelled bootstrap build) is deliberately
# "stale": there is nothing to preserve and a rebuild is cheap when the layers
# are already cached.
service_commit() {
  local name="$1" cid img
  cid="$(docker ps -q --filter "label=com.docker.swarm.service.name=$name" 2>/dev/null | head -1)"
  [ -n "$cid" ] || { echo ""; return 0; }
  img="$(docker inspect "$cid" -f '{{.Image}}' 2>/dev/null || echo "")"
  [ -n "$img" ] || { echo ""; return 0; }
  docker image inspect "$img" -f '{{index .Config.Labels "infra.commit"}}' 2>/dev/null || echo ""
}

rebuild_autoscaler=false; rebuild_admin=false
deploy_monitoring=false; deploy_ingress=false; deploy_admin=false

if changed autoscaler || [ "$(service_commit monitoring_autoscaler)" != "$got" ]; then
  rebuild_autoscaler=true; deploy_monitoring=true
fi
if changed admin || [ "$(service_commit admin_ui)" != "$got" ]; then
  rebuild_admin=true; deploy_admin=true
fi
changed config     && deploy_monitoring=true
[ -e "$INFRA_DIR/stacks/monitoring.yml" ] && \
  ! diff -q "$INFRA_DIR/stacks/monitoring.yml" "$work/repo/stacks/monitoring.yml" >/dev/null 2>&1 && deploy_monitoring=true
[ -e "$INFRA_DIR/stacks/ingress.yml" ] && \
  ! diff -q "$INFRA_DIR/stacks/ingress.yml" "$work/repo/stacks/ingress.yml" >/dev/null 2>&1 && deploy_ingress=true
[ -e "$INFRA_DIR/stacks/admin.yml" ] && \
  ! diff -q "$INFRA_DIR/stacks/admin.yml" "$work/repo/stacks/admin.yml" >/dev/null 2>&1 && deploy_admin=true

# --- swap the files in -------------------------------------------------------
# rsync with --delete so a file REMOVED upstream is removed here too; `cp -a`
# only ever adds, which leaves a deleted stack or a renamed script behind to be
# found months later. The excludes are the runtime state that is this cluster's
# and not the repo's — deleting those would take your components with them.
# The runtime excludes are ANCHORED with a leading slash, and that slash is
# load-bearing. An rsync pattern without one matches a directory of that name at
# ANY depth: `components/` was meant to protect `/opt/infra/components/` — your
# component specs, which the repo must never overwrite — and it silently also
# matched `/opt/infra/admin/components/`, the component CLASS LIBRARY, which is
# repo code and has to ship. The panel then built from a frozen copy of that
# package forever: a Redis with no `credentials()` (500 on the tab), an app with
# no Map tab, and no MongoDB in the create form, all while every other file in
# `admin/` updated normally and the updater reported success.
#
# It could not self-heal either. `changed admin` compares the two trees, saw the
# difference rsync had just refused to deliver, and rebuilt the same stale
# package on every single tick — the "permanent phantom change" the DIFF_SKIP
# comment above warns about, arrived at from the opposite direction.
rsync -a --delete \
  --exclude '.git' \
  --exclude '/components/' \
  --exclude '/state/' \
  --exclude 'config/vmagent.yml' \
  --exclude 'config/alertmanager.yml' \
  --exclude 'config/worker-cloud-init.yaml' \
  "$work/repo/" "$INFRA_DIR/"

# Did the copy actually deliver the code? The excludes above are the one thing
# in this script that can decline to copy a file and report success, and when
# one of them over-matches the result is a cluster that rebuilds a frozen
# directory on every tick forever. Comparing the delivered tree against the
# fetched one costs a directory walk and turns that into a loud failure — before
# the commit is recorded, so the panel shows "update failing" rather than the new
# SHA. Same exclusions as `changed()`, or generated config would fail it every
# time.
for area in admin autoscaler bin stacks config; do
  [ -e "$work/repo/$area" ] || continue
  diff -qr --no-dereference "${DIFF_SKIP[@]}" \
       "$INFRA_DIR/$area" "$work/repo/$area" >/dev/null 2>&1 \
    || die "$area still differs from the fetched tree after rsync — an exclude pattern is swallowing code. Refusing to build a stale image."
done

chmod +x "$INFRA_DIR"/bin/* 2>/dev/null || true
# Recorded BEFORE the rebuilds, because the files on disk are already the new
# ones: a build that fails after this point must not leave the cluster claiming
# to run the old commit it no longer has.
state_set "commit=$got" "updated_at=$(date -Is)" "previous=$running"
log "files updated to ${got:0:12}"

# --- rebuild and redeploy only what moved ------------------------------------
if [ "$rebuild_autoscaler" = true ]; then
  log "building autoscaler image"
  docker build -q --label "infra.commit=$got" \
    -t "${APP_NAME}/autoscaler:latest" "$INFRA_DIR/autoscaler" >/dev/null \
    || die "autoscaler image build failed — the files are updated but the old image is still running"
fi
if [ "$rebuild_admin" = true ]; then
  log "building admin image"
  docker build -q --label "infra.commit=$got" \
    -t "${APP_NAME}/admin:latest" "$INFRA_DIR/admin" >/dev/null \
    || die "admin image build failed — the files are updated but the old image is still running"
fi

# --- run the suite against the image just built, before anything is deployed --
# The tests existed and passed on a laptop; nothing ran them here, and a commit
# that crashlooped the autoscaler on import went straight into production
# because of it. A suite that is only a manual step is not a gate, so this is
# where it becomes one: the image is built, its own tests run INSIDE it, and a
# failure stops before any `docker stack deploy`.
#
# The repo is mounted rather than baked in: the panel's suite reaches the repo
# ROOT — stacks/monitoring.yml, master-cloud-init.yaml — to pin the three copies
# of every setting's default against each other, and the image only carries
# `admin/`. Read-only, because a test that needs to write to /opt/infra is a
# test that would corrupt the cluster it is checking; the panel's own tests
# point INFRA_DIR at a temp directory of their own.
#
# On failure the commit has already been recorded, so the panel says "update
# failing" with the reason and the PREVIOUS containers keep serving. The next
# push changes `remote` and the tick runs again — a fix is a push, which is the
# same motion that got you here.
run_suite() {
  local area="$1" image="$2"
  [ -d "$INFRA_DIR/$area/tests" ] || return 0
  log "running $area tests against the image just built"
  docker run --rm \
    -v "$INFRA_DIR:/repo:ro" -w "/repo/$area" \
    -e PYTHONDONTWRITEBYTECODE=1 \
    --entrypoint python "$image" -m unittest discover -s tests >"$work/$area-tests.log" 2>&1 \
    || { log "--- $area tests ---"; tail -30 "$work/$area-tests.log" | while IFS= read -r l; do log "  $l"; done
         die "$area tests failed against the newly built image — refusing to deploy it"; }
}

[ "$rebuild_autoscaler" = true ] && run_suite autoscaler "${APP_NAME}/autoscaler:latest"
[ "$rebuild_admin" = true ] && run_suite admin "${APP_NAME}/admin:latest"

# A LOCALLY-BUILT IMAGE IS INVISIBLE TO SWARM'S SPEC DIFF, and this is the whole
# reason a pushed commit could land, record itself, and change nothing you could
# see. `${APP_NAME}/admin:latest` exists only in this box's image store, so
# `docker stack deploy` cannot resolve it to a digest and writes the bare tag
# into the service spec. Rebuild that tag and the spec is byte-identical to the
# running one — Swarm compares, finds no difference, and keeps the old container
# serving while the image just built sits unused. The updater then reports
# success, the panel shows the new commit, and the code is the old code.
#
# It is the same failure the vmagent/vmalert force below already covers, framed
# differently: there the config moved without the spec, here the image did.
#
# Forced whenever the image was rebuilt, including when the stack file moved too
# and the deploy already restarted it. That costs a second rolling restart in a
# case that is rare, and the alternative — inferring that the deploy must have
# picked it up — is the assumption that produced this bug.
force_service() {
  local service="$1"
  log "restarting $service onto the image just built"
  docker service update --force --quiet "$service" >/dev/null 2>&1 \
    || log "WARNING: could not restart $service — it is STILL RUNNING THE OLD IMAGE"
}

# monitoring first: it owns the network the other two declare external, and
# stack-deploy re-renders vmagent.yml and alertmanager.yml on the way through.
if [ "$deploy_monitoring" = true ]; then
  log "deploying monitoring"
  "$INFRA_DIR/bin/stack-deploy" monitoring >/dev/null || die "monitoring deploy failed"
  # A bind-mounted config changes nothing in the service spec, so Swarm has
  # nothing to update and the old config stays loaded. These two read theirs
  # from disk and need telling.
  docker service update --force --quiet "monitoring_vmagent" >/dev/null 2>&1 || true
  docker service update --force --quiet "monitoring_vmalert" >/dev/null 2>&1 || true
fi
[ "$rebuild_autoscaler" = true ] && force_service "monitoring_autoscaler"
[ "$deploy_ingress" = true ] && { log "deploying ingress"; "$INFRA_DIR/bin/stack-deploy" ingress >/dev/null || die "ingress deploy failed"; }

# admin LAST, and on purpose: it is the console you would use to find out that
# an update went wrong, so it stays up for as much of the update as possible.
if [ "$deploy_admin" = true ]; then
  log "deploying admin"
  "$INFRA_DIR/bin/stack-deploy" admin >/dev/null || die "admin deploy failed"
fi
[ "$rebuild_admin" = true ] && force_service "admin_ui"

if [ "$rebuild_autoscaler" = false ] && [ "$rebuild_admin" = false ] \
   && [ "$deploy_monitoring" = false ] && [ "$deploy_ingress" = false ] \
   && [ "$deploy_admin" = false ]; then
  log "no infrastructure stack changed; files only"
fi

state_set "status=ok" "detail="
log "updated to ${got:0:12}"
