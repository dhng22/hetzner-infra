#!/usr/bin/env bash
# =============================================================================
# smoke-test — prove the cluster actually works, on the master, after a deploy.
# =============================================================================
#   smoke-test          read-only checks; safe on production at any time
#   smoke-test --deep   also performs a real no-op deploy and a real CI webhook
#                       call. Both are designed to be non-disruptive, but they
#                       do write. Run it once after bootstrap, then read-only.
#
# Every check here exists because something in this system can fail silently:
# a panel with no docker CLI, a deploy that ships no registry credential, an
# alert rule that can never fire. "docker service ls looks fine" is not proof.
# =============================================================================

set -uo pipefail

INFRA_DIR="${INFRA_DIR:-/opt/infra}"
INFRA_ENV="${INFRA_ENV:-/etc/infra/infra.env}"
DEEP=0
[ "${1:-}" = "--deep" ] && DEEP=1

PASS=0; FAIL=0; SKIP=0
G="\033[32m"; R="\033[31m"; Y="\033[33m"; D="\033[2m"; Z="\033[0m"

ok()   { PASS=$((PASS+1)); printf "  ${G}pass${Z}  %s\n" "$1"; }
bad()  { FAIL=$((FAIL+1)); printf "  ${R}FAIL${Z}  %s\n" "$1"; [ -n "${2:-}" ] && printf "        ${D}%s${Z}\n" "$2"; }
skip() { SKIP=$((SKIP+1)); printf "  ${Y}skip${Z}  %s ${D}(%s)${Z}\n" "$1" "${2:-}"; }
head_() { printf "\n${D}--- %s ---${Z}\n" "$1"; }

check() { # check <label> <command...>
  local label="$1"; shift
  local out
  if out="$("$@" 2>&1)"; then ok "$label"; else bad "$label" "$(echo "$out" | tail -2)"; fi
}

[ -f "$INFRA_ENV" ] || { echo "no $INFRA_ENV — run this on the master"; exit 1; }
set -a; . "$INFRA_ENV"; set +a
# Components are discovered, not listed. Anything the autoscaler manages carries
# infra.workload=app; anything the panel created carries infra.component.
APP_SERVICES="$(docker service ls --filter label=infra.workload=app --format '{{.Name}}' 2>/dev/null)"
COMPONENT_SERVICES="$(docker service ls --format '{{.Name}}' 2>/dev/null \
                      | grep -vE '^(monitoring|ingress|admin)_' || true)"

# ---------------------------------------------------------------------------
head_ "host"
check "docker engine responds"        docker info
if docker info 2>/dev/null | grep -q "Swarm: active"; then ok "swarm is active"; else bad "swarm is active"; fi
if ufw status 2>/dev/null | grep -q "Status: active"; then ok "ufw is enabled"; else bad "ufw is enabled"; fi
if ufw status 2>/dev/null | grep -qE "^22/tcp .*ALLOW"; then ok "ssh (22) still allowed"; else bad "ssh (22) still allowed" "you may be locked out on next reboot"; fi

# ---------------------------------------------------------------------------
head_ "images and stacks"
# Pulled from GHCR, one immutable tag per commit — not built here. Missing means
# either the pull never happened or somebody deleted the package version out
# from under a running cluster, and both leave Swarm unable to reschedule.
if . "$INFRA_DIR/bin/infra-images" 2>/dev/null && infra_images 2>/dev/null; then
  for img in $(infra_image_refs); do
    if docker image inspect "$img" >/dev/null 2>&1; then
      ok "image present: $img"
    else
      bad "image present: $img" \
          "the master cannot start this service without it. Try: docker pull $img"
    fi
  done
else
  skip "infrastructure images present" "this cluster has no recorded commit to name them by"
fi
for stack in monitoring ingress admin; do
  if docker stack ls --format '{{.Name}}' | grep -qx "$stack"; then ok "stack deployed: $stack"; else bad "stack deployed: $stack"; fi
done

# A RENAMED infrastructure service does not go away on its own. `bin/stack-deploy`
# deploys without `--prune` on purpose — an operator who added a service to an
# infra stack by hand should not lose it to an unrelated update — so the old name
# keeps running: still scraped, still holding a reservation the capacity model
# subtracts from application room, and still POSTing stale verdicts. bin/infra-update
# removes each retirement by name; this is what proves it did.
for retired in monitoring_dispatcher; do
  if docker service inspect "$retired" >/dev/null 2>&1; then
    bad "$retired is gone" \
        "it was renamed and the old service is still running. Remove it: docker service rm $retired"
  else
    ok "$retired is gone (renamed)"
  fi
done

# Is the CODE that is running the code the panel says is running?
#
# Asked of the CONTAINER, never of the tag or of the service spec. A spec can
# name the right image while the task that is actually serving was started from
# the previous one — a rollout still in progress, a rollout Swarm rolled back
# after the new tasks failed their health check, a node that could not pull. All
# three report a perfectly correct spec, and the panel would show the new commit
# over the old code.
want_commit="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("commit") or "")' \
                 "$INFRA_DIR/state/version.json" 2>/dev/null || echo "")"
if [ -z "$want_commit" ]; then
  skip "running code matches the recorded commit" "this cluster does not self-update"
else
  for name in admin_ui monitoring_autoscaler monitoring_overseer monitoring_dataguard; do
    # All three are pinned to the manager, so the container is on this host.
    cid="$(docker ps -q --filter "label=com.docker.swarm.service.name=$name" | head -1)"
    [ -n "$cid" ] || { skip "$name runs the recorded commit" "no container on this node"; continue; }
    img_id="$(docker inspect "$cid" -f '{{.Image}}' 2>/dev/null || echo "")"
    built="$(docker image inspect "$img_id" \
               -f '{{index .Config.Labels "infra.commit"}}' 2>/dev/null || echo "")"
    if [ "$built" = "$want_commit" ]; then
      ok "$name runs the recorded commit (${want_commit:0:12})"
    else
      bad "$name runs the recorded commit" \
          "version.json says ${want_commit:0:12} but $name is on ${built:-an unlabelled image}. The rollout did not take. Look at why first: docker service ps --no-trunc $name"
    fi
  done
fi
# The edge network is created by bootstrap, not by a stack, precisely so that
# removing a component cannot take the tunnel's route to everything else with it.
if docker network inspect edge >/dev/null 2>&1; then ok "edge network exists"; else bad "edge network exists" "components cannot be deployed and the tunnel can reach nothing"; fi
if [ -z "$COMPONENT_SERVICES" ]; then
  skip "components deployed" "none created yet — a valid state for a fresh cluster"
fi

# ---------------------------------------------------------------------------
head_ "services converged"
while read -r name replicas; do
  [ -z "$name" ] && continue
  running="${replicas%%/*}"; want="${replicas##*/}"
  # 0/0 IS CONVERGED. It is a service that was asked for zero replicas and is
  # running zero, which in this cluster is a designed state and not a fault:
  # standby replica-set members are created at 0 and started by dataguard when
  # the topology grows, and a data viewer sits at 0 until somebody presses
  # View. Reporting eight of those as failures buried the one real one and had
  # me telling the operator his databases were not deployed while mongo and
  # redis were serving traffic.
  if [ "$running" = "$want" ] && [ "$running" != "0" ]; then
    ok "$name ($replicas)"
  elif [ "$want" = "0" ]; then
    ok "$name (stopped on purpose)"
  else
    bad "$name ($replicas)" "$(docker service ps --no-trunc --format '{{.Error}}' "$name" 2>/dev/null | grep -v '^$' | head -1)"
  fi
done < <(docker service ls --format '{{.Name}} {{.Replicas}}')

# ---------------------------------------------------------------------------
# Placement is a two-state machine the autoscaler drives, and every failure in
# it is silent: tasks sit pending, or production quietly runs on the master.
# Assert the state is self-consistent rather than trusting `service ls`.
head_ "placement mode"
READY_WORKERS="$(docker node ls --format '{{.Hostname}} {{.Status}} {{.ManagerStatus}}' \
                 | awk '$3 == "" && $2 == "Ready"' | wc -l | tr -d ' ')"

if [ -z "$APP_SERVICES" ]; then
  skip "placement" "no service carries infra.workload=app, so there is nothing to place"
else
  PINNED_LIST=""; UNPINNED_LIST=""
  for svc in $APP_SERVICES; do
    if docker service inspect "$svc" \
         --format '{{range .Spec.TaskTemplate.Placement.Constraints}}{{println .}}{{end}}' 2>/dev/null \
         | tr -d ' ' | grep -qx 'node.role==worker'; then
      PINNED_LIST="$PINNED_LIST $svc"
    else
      UNPINNED_LIST="$UNPINNED_LIST $svc"
    fi
  done

  if [ -n "$PINNED_LIST" ] && [ "$READY_WORKERS" = "0" ]; then
    bad "applications are placeable" \
        "pinned to node.role==worker with no ready worker —$PINNED_LIST cannot be placed at all. The autoscaler fails back within a loop; check its logs."
  elif [ -n "$PINNED_LIST" ] && [ -n "$UNPINNED_LIST" ]; then
    skip "placement is settled" "mid-handover: pinned$PINNED_LIST / unpinned$UNPINNED_LIST — re-run shortly"
  elif [ -n "$PINNED_LIST" ]; then
    ok "worker mode: $READY_WORKERS ready worker(s), every application pinned to them"
    STRAY=0
    for svc in $APP_SERVICES; do
      n="$(docker service ps "$svc" --filter desired-state=running --format '{{.Node}}' 2>/dev/null \
           | grep -cx "$(hostname)" || true)"
      [ "${n:-0}" != "0" ] && STRAY=$((STRAY + n))
    done
    if [ "$STRAY" != "0" ]; then
      bad "master carries no application replicas" \
          "$STRAY task(s) still on the master while pinned to workers — a handover did not finish"
    else
      ok "master carries no application replicas"
    fi
  else
    if [ "$READY_WORKERS" != "0" ]; then
      skip "manager mode with $READY_WORKERS worker(s) present" "mid-handover, or MIN_WORKERS raised; re-run shortly"
    else
      ok "manager mode: no workers, the master runs everything (scale-to-zero resting state)"
    fi
  fi
fi

# Capacity is measured from Swarm reservations, so the thing worth checking is
# that they exist at all. Without them Swarm sees an idle box and the autoscaler
# believes in room that is not there.
for svc in $APP_SERVICES; do
  if docker service inspect "$svc" \
       --format '{{.Spec.TaskTemplate.Resources.Reservations.NanoCPUs}}' 2>/dev/null \
       | grep -qE '^[1-9]'; then
    ok "$svc declares a CPU reservation (the autoscaler's capacity unit)"
  else
    bad "$svc declares a CPU reservation" \
        "the autoscaler cannot see it and will pack replicas on top of it"
  fi
done

# The infrastructure's own reservations are what stop application replicas being
# scheduled on top of the metrics database.
for g in monitoring_victoriametrics monitoring_loki admin_ui; do
  if docker service inspect "$g" \
       --format '{{.Spec.TaskTemplate.Resources.Reservations.MemoryBytes}}' 2>/dev/null \
       | grep -qE '^[1-9]'; then
    ok "$g reserves memory (keeps application replicas off the master's headroom)"
  else
    bad "$g reserves memory" \
        "the autoscaler will over-count the master and place replicas on top of it"
  fi
done

# A stateful service that ended up labelled as an application would be moved to
# a worker and deleted with it. This is the check that catches it before that.
for svc in $APP_SERVICES; do
  if docker service inspect "$svc" \
       --format '{{range .Spec.TaskTemplate.ContainerSpec.Mounts}}{{.Type}}{{end}}' 2>/dev/null \
       | grep -q volume; then
    bad "$svc has no volume" \
        "it is labelled infra.workload=app AND mounts a volume — it will be moved onto workers that are later deleted"
  fi
done

if [ "${MIN_WORKERS:-0}" -lt 0 ]; then
  bad "MIN_WORKERS >= 0" "0 already means 'no Hetzner workers'; there is nothing below it"
elif [ "${MIN_WORKERS:-0}" -eq 0 ]; then
  ok "MIN_WORKERS is 0 — the free floor, master carries the load, nothing billed"
else
  ok "MIN_WORKERS (${MIN_WORKERS}) workers always run; the master carries no application"
fi

# ---------------------------------------------------------------------------
head_ "admin panel container"
ADMIN_CID="$(docker ps -q -f name=admin_ui | head -1)"
if [ -z "$ADMIN_CID" ]; then
  bad "admin container running"
else
  ok "admin container running"
  # The three things that silently make every button in the UI a no-op.
  check "  panel has the docker CLI"    docker exec "$ADMIN_CID" docker --version
  check "  panel can reach the socket"  docker exec "$ADMIN_CID" docker service ls
  check "  panel has an ssh client"     docker exec "$ADMIN_CID" ssh -V
  if docker exec "$ADMIN_CID" test -s /root/.docker/config.json 2>/dev/null; then
    ok "  panel has registry credentials"
  else
    bad "  panel has registry credentials" "deploys would ship no auth; workers cannot pull private images"
  fi
  if docker exec "$ADMIN_CID" test -r /run/secrets/PANEL_SSH_KEY 2>/dev/null; then
    perms="$(docker exec "$ADMIN_CID" stat -c '%a' /run/secrets/PANEL_SSH_KEY 2>/dev/null)"
    if [ "$perms" = "400" ] || [ "$perms" = "600" ]; then
      ok "  ssh key mounted with usable permissions ($perms)"
    else
      bad "  ssh key permissions are $perms" "ssh refuses keys readable by group/other"
    fi
  else
    bad "  ssh key mounted"
  fi
  check "  health endpoint"             docker exec "$ADMIN_CID" python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:3000/healthz')"

  # The restricted host channel, end to end.
  if out="$(docker exec "$ADMIN_CID" python -c "import hostops,sys;ok,o=hostops.status();print(o);sys.exit(0 if ok else 1)" 2>&1)"; then
    ok "  host ops over ssh (ufw-status)"
  else
    bad "  host ops over ssh (ufw-status)" "$(echo "$out" | tail -2)"
  fi
  if docker exec "$ADMIN_CID" ssh -i /run/secrets/PANEL_SSH_KEY -o IdentitiesOnly=yes \
       -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=8 \
       "root@${MASTER_PRIVATE_IP}" "id" >/dev/null 2>&1; then
    bad "  ssh key is restricted to panel-hostops" "arbitrary commands are being accepted"
  else
    ok "  ssh key refuses arbitrary commands"
  fi
fi

# ---------------------------------------------------------------------------
head_ "components"
if [ ! -d "$INFRA_DIR/components" ]; then
  bad "components directory exists" "bootstrap did not create $INFRA_DIR/components"
elif [ -z "$(ls -A "$INFRA_DIR/components" 2>/dev/null)" ]; then
  skip "components created" "none yet — create one in the panel or with 'component create'"
else
  for dir in "$INFRA_DIR/components"/*/; do
    name="$(basename "$dir")"
    [ -f "$dir/component.json" ] || continue

    # A spec that will not render is a component that cannot be deployed, and
    # nothing else in the system notices until you press a button.
    if out="$("$INFRA_DIR/bin/component" render "$name" 2>&1 >/dev/null)"; then
      ok "$name renders"
    else
      bad "$name renders" "$(echo "$out" | tail -2)"
    fi

    # Credentials must not be world-readable. write_atomic chmods before the
    # rename so this can only fail if something else wrote the file.
    for f in env secret.env; do
      [ -f "$dir/$f" ] || continue
      mode="$(stat -c '%a' "$dir/$f" 2>/dev/null || stat -f '%Lp' "$dir/$f" 2>/dev/null)"
      if [ "$mode" = "600" ]; then
        ok "$name/$f is 0600"
      else
        bad "$name/$f is 0600" "found $mode — a database password is readable by other users"
      fi
    done

    type="$(python3 -c "import json;print(json.load(open('$dir/component.json'))['type'])" 2>/dev/null)"
    # A component's services are NUMBERED once it has members — `database` of
    # type mongo deploys `database_mongo-1`, not `database_mongo`. Looking only
    # for the bare name reported a fully deployed replica set as "spec exists
    # but not running", which is a diagnostic that lies in the one direction
    # that costs an operator the most: it says a healthy database is missing.
    svc="$(docker service ls --format '{{.Name}}' \
           | grep -E "^${name}_${type}(-[0-9]+)?$" | sort | head -1)"
    if [ -z "$svc" ]; then
      skip "$name is deployed" "spec exists but no ${name}_${type} service is running — run 'component deploy $name'"
      continue
    fi

    # The password the server enforces must be the one the panel shows you.
    # It goes through `sh -c`, so an unexpanded $REDIS_PASSWORD in the argv is
    # the specific failure worth naming: the server would enforce the literal
    # string while every client got the real one.
    # A managed database's members are one mongod per volume. If one of them
    # ever carried infra.workload=app the autoscaler would scale it, and a
    # second mongod on one data directory is corruption rather than an outage.
    # WHICH SERVICE HOLDS THE SERVER depends on whether dataguard manages it.
    # A managed database is members `<name>_<type>-1..n`; an unmanaged one is
    # the single unsuffixed `<name>_<type>` it has always been. Hardcoding the
    # member name made both checks below inspect a service that does not exist
    # on an unmanaged component, and then report the miss as a drifted password
    # and an unexpanded shell variable -- two alarming, specific and wrong
    # diagnoses for "you looked in the wrong place".
    managed=no
    if docker service inspect "$svc" \
         --format '{{index .Spec.Labels "infra.managed_by"}}' 2>/dev/null \
         | grep -qx dataguard; then
      managed=yes
    fi
    if [ "$managed" = yes ]; then
      member="${name}_${type}-1"
    else
      member="$svc"
    fi

    if [ "$managed" = yes ]; then
      if docker service inspect "$svc" \
           --format '{{index .Spec.Labels "infra.workload"}}' 2>/dev/null | grep -qx app; then
        bad "$name is not both a database and an application" \
            "it carries infra.managed_by=dataguard AND infra.workload=app. Remove one."
      else
        ok "$name is managed by dataguard and invisible to the autoscaler"
      fi
    fi

    if [ "$type" = "redis" ]; then
      svc="$member"
      want="$(grep -m1 '^REDIS_PASSWORD=' "$dir/secret.env" 2>/dev/null | cut -d= -f2-)"
      got="$(docker service inspect "$svc" \
             --format '{{range .Spec.TaskTemplate.ContainerSpec.Env}}{{println .}}{{end}}' 2>/dev/null \
             | grep '^REDIS_PASSWORD=' | cut -d= -f2-)"
      if [ -n "$want" ] && [ "$want" = "$got" ]; then
        ok "$name: the running server has the password the panel shows"
      else
        bad "$name: the running server has the password the panel shows" \
            "redeploy it — the file and the service have drifted"
      fi
      if docker service inspect "$svc" \
           --format '{{range .Spec.TaskTemplate.ContainerSpec.Args}}{{println .}}{{end}}' 2>/dev/null \
           | grep -q 'exec redis-server'; then
        ok "$name expands its password through a shell"
      else
        bad "$name expands its password through a shell" \
            "without 'sh -c' the server enforces the literal string \$REDIS_PASSWORD"
      fi
    fi

    # The same check the redis half has had all along, which mongo never did.
    # The panel shows you a password; the server has to be enforcing that one.
    if [ "$type" = "mongo" ]; then
      msvc="$member"
      want="$(grep -m1 '^MONGO_PASSWORD=' "$dir/secret.env" 2>/dev/null | cut -d= -f2-)"
      got="$(docker service inspect "$msvc" \
             --format '{{range .Spec.TaskTemplate.ContainerSpec.Env}}{{println .}}{{end}}' 2>/dev/null \
             | grep '^MONGO_INITDB_ROOT_PASSWORD=' | cut -d= -f2-)"
      if [ -n "$want" ] && [ "$want" = "$got" ]; then
        ok "$name: the running server has the password the panel shows"
      else
        bad "$name: the running server has the password the panel shows" \
            "redeploy it — the file and the service have drifted"
      fi

      # Replication is every write you have ever made, and once a member lives on
      # another machine it crosses the network. `requireTLS`, not `preferTLS`: a
      # mode that ACCEPTS plaintext will carry plaintext the first time a client
      # gets its options wrong, and nothing will say so.
      if docker service inspect "$msvc" \
           --format '{{range .Spec.TaskTemplate.ContainerSpec.Args}}{{println .}}{{end}}' 2>/dev/null \
           | grep -q -- '--tlsMode requireTLS'; then
        ok "$name requires TLS on every connection, replication included"
      else
        bad "$name requires TLS on every connection, replication included" \
            "the oplog would cross the network in clear text once a second member exists"
      fi

      # 0400 and owned by the mongod user, or mongod refuses to start and the
      # error names the file rather than the ownership.
      if docker service inspect "$msvc" \
           --format '{{range .Spec.TaskTemplate.ContainerSpec.Secrets}}{{.File.Name}} {{.File.Mode}} {{.File.UID}}{{println}}{{end}}' 2>/dev/null \
           | grep -q 'tls-member.pem 256 999'; then
        ok "$name mounts its certificate at 0400 owned by mongod"
      else
        bad "$name mounts its certificate at 0400 owned by mongod" \
            "mongod refuses a key file it does not own, and the error blames the file"
      fi
    fi
  done
fi

# ---------------------------------------------------------------------------
head_ "dataguard"

# Dataguard is the only infrastructure service attached to `edge` as well as
# `monitoring` — it has to be, because mongod and redis live there. That makes
# ONE property load-bearing: its /signal receiver, which rewrites database
# topology, must be bound to the monitoring address only. If it ever binds
# 0.0.0.0, every application in the cluster can reach it.
if docker service inspect monitoring_dataguard >/dev/null 2>&1; then
  if docker run --rm --network edge curlimages/curl:8.10.1 \
       -fsS -m 4 -X POST --data '{}' http://monitoring_dataguard:9202/signal >/dev/null 2>&1; then
    bad "dataguard's /signal is unreachable from edge" \
        "an application could POST a verdict that rewrites its own database's topology"
  else
    ok "dataguard's /signal is unreachable from edge"
  fi
  if docker run --rm --network monitoring curlimages/curl:8.10.1 \
       -fsS -m 4 -X POST --data '{"signals":[]}' \
       http://monitoring_dataguard:9202/signal >/dev/null 2>&1; then
    ok "dataguard's /signal answers on the monitoring overlay"
  else
    bad "dataguard's /signal answers on the monitoring overlay" \
        "the overseer cannot dispatch to it, so no database is being managed"
  fi
else
  skip "dataguard's /signal binding" "dataguard is not deployed"
fi

# ---------------------------------------------------------------------------
head_ "monitoring"
vm() { docker run --rm --network monitoring curlimages/curl:8.10.1 -fsS "$@" 2>/dev/null; }
if q="$(vm "http://victoriametrics:8428/api/v1/query?query=up" )"; then
  ok "victoriametrics answers queries"
  for metric in autoscaler_last_loop_timestamp_seconds autoscaler_managed_services node_cpu_seconds_total; do
    if vm "http://victoriametrics:8428/api/v1/query?query=${metric}" | grep -q '"result":\[{'; then
      ok "  metric present: $metric"
    else
      bad "  metric present: $metric" "nothing is scraping it"
    fi
  done
else
  bad "victoriametrics answers queries"
fi
if vm "http://vmalert:8880/api/v1/rules" | grep -q '"name":"Watchdog"'; then
  ok "vmalert loaded the rules"
else
  bad "vmalert loaded the rules"
fi
# The destination is the last hop, and the only part of this pipeline that can
# fail while everything upstream looks perfect. Bootstrap no longer refuses to
# run without it, so this is what makes the state visible instead.
if grep -q "telegram_configs" "$INFRA_DIR/config/alertmanager.yml" 2>/dev/null; then
  ok "alerts have a destination (Telegram)"
elif grep -qE "slack_configs|webhook_configs" "$INFRA_DIR/config/alertmanager.yml" 2>/dev/null; then
  ok "alerts have a destination"
else
  bad "alerts have a destination" \
      "alertmanager.yml has a receiver with no configs — every alert is generated, grouped and then DROPPED. Add a destination under Alerts > Targets, then: stack-deploy monitoring"
fi
# It holds a bot token, so it must not be WORLD-readable. Not 0600 though: that
# is what this check used to demand and it is wrong. prom/alertmanager runs as
# `nobody` (uid 65534) and the file is a bind mount, so 0600 root meant the
# container could not read its own config — it exited 1 on "permission denied"
# and crash-looped from the very first deploy while every other service came up
# fine. bin/stack-deploy therefore writes it 0640 root:nogroup on purpose, and
# this assertion has sat in permanent disagreement with that fix, failing every
# smoke test on a cluster that is correct.
#
# The property that actually matters is the last digit: nothing outside the
# owner and that one group may read it.
if [ -f "$INFRA_DIR/config/alertmanager.yml" ]; then
  mode="$(stat -c '%a' "$INFRA_DIR/config/alertmanager.yml" 2>/dev/null || stat -f '%Lp' "$INFRA_DIR/config/alertmanager.yml" 2>/dev/null)"
  case "$mode" in
    *0) ok "alertmanager.yml is not world-readable ($mode)" ;;
    *)  bad "alertmanager.yml is not world-readable" \
            "found $mode — it holds the alert bot token. bin/stack-deploy writes it 0640 root:nogroup; something else has changed it." ;;
  esac
fi

if vm "http://alertmanager:9093/api/v2/status" | grep -q '"cluster"'; then
  ok "alertmanager is up"
else
  bad "alertmanager is up"
fi
if vm "http://loki:3100/ready" >/dev/null; then ok "loki is ready"; else bad "loki is ready"; fi

# ---------------------------------------------------------------------------
head_ "deploy paths (read-only)"
# Validate the env files the generator consumes: malformed lines are dropped
# silently at deploy time, so catching them here is the point.
for f in "$INFRA_DIR"/components/*/env; do
  [ -f "$f" ] || continue
  problems="$(awk -v FS='=' '
    /^[[:space:]]*(#|$)/ { next }
    !/=/ { print "  line " NR ": no \"=\" -> ignored at deploy: " $0; next }
    $1 !~ /^[A-Za-z_][A-Za-z0-9_]*$/ { print "  line " NR ": invalid name: " $1 }
  ' "$f" 2>/dev/null)"
  if [ -z "$problems" ]; then ok "$(basename "$(dirname "$f")")/env parses cleanly"; else bad "$(basename "$(dirname "$f")")/env parses cleanly" "$problems"; fi
done

if [ -x "$INFRA_DIR/bin/component" ]; then ok "bin/component is executable"; else bad "bin/component is executable"; fi
if [ -x "$INFRA_DIR/bin/stack-deploy" ]; then ok "bin/stack-deploy is executable"; else bad "bin/stack-deploy is executable"; fi
if [ -x "$INFRA_DIR/bin/panel-hostops" ]; then ok "bin/panel-hostops is executable"; else bad "bin/panel-hostops is executable"; fi

# The webhook must reject a bad token even when everything else is healthy.
HOOK_COMPONENT="$(ls "$INFRA_DIR/components" 2>/dev/null | head -1)"
HOOK="http://127.0.0.1:3000/hooks/deploy/${HOOK_COMPONENT:-none}"
code="$(curl -s -o /dev/null -w '%{http_code}' -X POST "$HOOK" -H 'X-Deploy-Token: definitely-wrong' -H 'Content-Type: application/json' -d '{"image":"x:1"}')"
[ "$code" = "401" ] && ok "webhook rejects a bad token (401)" || bad "webhook rejects a bad token" "got $code"

TOKEN="$(python3 -c "
import json
try:
    print(json.load(open('$INFRA_DIR/state/deploy-tokens.json')).get('${HOOK_COMPONENT}', ''))
except Exception:
    print('')
" 2>/dev/null)"
if [ -z "$TOKEN" ]; then
  skip "webhook accepts a good token" "no token issued yet — open the Deployments tab once"
else
  code="$(curl -s -o /dev/null -w '%{http_code}' -X POST "$HOOK" -H "X-Deploy-Token: $TOKEN" -H 'Content-Type: application/json' -d '{"image":"ghcr.io/x/y:latest"}')"
  [ "$code" = "400" ] && ok "webhook refuses :latest with a good token (400)" || bad "webhook refuses :latest" "got $code"
fi

# ---------------------------------------------------------------------------
if [ "$DEEP" = "1" ]; then
  head_ "deep checks (these write)"
  # A no-op deploy of one component: same spec, same image, same replica count.
  # Proves the whole path works without changing what is running — and proves
  # the live-state pinning, which is the thing that silently rolls production
  # back when it breaks.
  TARGET="$(docker service ls --filter label=infra.workload=app --format '{{.Name}}' | head -1)"
  if [ -z "$TARGET" ]; then
    skip "no-op redeploy" "no application component to redeploy"
  else
    COMPONENT="${TARGET%%_*}"
    before_img="$(docker service inspect "$TARGET" --format '{{.Spec.TaskTemplate.ContainerSpec.Image}}')"
    before_rep="$(docker service inspect "$TARGET" --format '{{.Spec.Mode.Replicated.Replicas}}')"
    before_pin="$(docker service inspect "$TARGET" --format '{{range .Spec.TaskTemplate.Placement.Constraints}}{{println .}}{{end}}' | tr -d ' \n')"
    if out="$("$INFRA_DIR/bin/component" deploy "$COMPONENT" 2>&1)"; then
      ok "component deploy $COMPONENT succeeded"
    else
      bad "component deploy $COMPONENT" "$(echo "$out" | tail -3)"
    fi
    after_img="$(docker service inspect "$TARGET" --format '{{.Spec.TaskTemplate.ContainerSpec.Image}}')"
    after_rep="$(docker service inspect "$TARGET" --format '{{.Spec.Mode.Replicated.Replicas}}')"
    after_pin="$(docker service inspect "$TARGET" --format '{{range .Spec.TaskTemplate.Placement.Constraints}}{{println .}}{{end}}' | tr -d ' \n')"
    [ "$before_img" = "$after_img" ] && ok "redeploy preserved the image" || bad "redeploy preserved the image" "$before_img -> $after_img"
    [ "$before_rep" = "$after_rep" ] && ok "redeploy preserved the replica count ($after_rep)" || bad "redeploy preserved replicas" "$before_rep -> $after_rep"
    [ "$before_pin" = "$after_pin" ] && ok "redeploy preserved the placement pin" || bad "redeploy preserved the placement pin" "$before_pin -> $after_pin"
  fi

  if out="$("$INFRA_DIR/bin/stack-deploy" monitoring 2>&1)"; then ok "stack-deploy monitoring"; else bad "stack-deploy monitoring" "$(echo "$out" | tail -3)"; fi
  # Components are not infrastructure stacks and must not be routable through
  # the path that re-applies a file wholesale.
  if "$INFRA_DIR/bin/stack-deploy" "${COMPONENT:-anything}" >/dev/null 2>&1; then
    bad "stack-deploy refuses a component" "it should redirect you to 'component deploy'"
  else
    ok "stack-deploy refuses a component"
  fi
else
  head_ "deep checks"
  skip "no-op deploy, replica/image preservation, stack-deploy" "re-run with --deep"
fi

# ---------------------------------------------------------------------------
printf "\n${D}=====================================${Z}\n"
printf "  ${G}%d passed${Z}   ${R}%d failed${Z}   ${Y}%d skipped${Z}\n" "$PASS" "$FAIL" "$SKIP"
[ "$FAIL" -eq 0 ] || printf "  ${R}Something above is broken. Do not assume it will fix itself.${Z}\n"
exit $([ "$FAIL" -eq 0 ] && echo 0 || echo 1)
