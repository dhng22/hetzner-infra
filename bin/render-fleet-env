#!/usr/bin/env python3
"""
Write /etc/infra/fleet.env — the settings the autoscaler is allowed to see.

    render-fleet-env [<output path>]

stacks/monitoring.yml hands this file to the autoscaler with `env_file`, so the
stack names a FILE rather than listing variables one by one. That is the whole
point: adding a fleet setting is a line in admin/settings_def.py and the `_env`
call that reads it, and nothing in the stack has to be touched for the value to
arrive.

It is GENERATED on every deploy, like config/vmagent.yml and
config/alertmanager.yml next to it, and for the same reason: /etc/infra/infra.env
is written once at boot and never gains a key, so anything derived from it has to
be rebuilt rather than stored. A setting the file has never heard of is written
here with the repo's default, which is what makes a new knob work on a cluster
older than it.

Only settings.py's allow-list is written — the Identity, Hetzner and Fleet groups
minus anything SECRET. The admin password, the Cloudflare token and the alert
credentials live in the same infra.env and must not end up in this container's
environment; HCLOUD_TOKEN is the one credential the autoscaler needs and it
arrives as a docker secret instead.
"""

import os
import sys

INFRA_DIR = os.environ.get("INFRA_DIR", "/opt/infra")
INFRA_ENV = os.environ.get("INFRA_ENV", "/etc/infra/infra.env")
sys.path.insert(0, os.path.join(INFRA_DIR, "admin"))

import envstore  # noqa: E402
import settings_def  # noqa: E402


def main():
    out_path = sys.argv[1] if len(sys.argv) > 1 else "/etc/infra/fleet.env"
    # envstore's parser, not a second one. infra.env is a DOCUMENTED file: most
    # lines carry a trailing comment, and shell rules say whitespace before `#`
    # starts one. A naive split gave WORKER_TYPE the value
    # "cpx22              # shared worker pool" and MAX_WORKERS the value
    # "5                  # a BUDGET cap, not a capacity plan" — which is an
    # int() that raises at import and an autoscaler that crashloops, the exact
    # failure this whole change exists to make unrepeatable.
    resolved = settings_def.autoscaler_env(envstore.load_infra())

    body = ["# Generated by bin/render-fleet-env. Edits here are overwritten on",
            "# every deploy — change a setting in the panel, or in infra.env.", ""]
    body += [f"{key}={value}" for key, value in resolved.items()]

    # Written whole and moved into place: a deploy reading this file halfway
    # through a rewrite would hand the autoscaler half its configuration.
    tmp = out_path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("\n".join(body) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, out_path)
    print(f"wrote {out_path} ({len(resolved)} settings)")


if __name__ == "__main__":
    main()
