# Production application configuration.
#
# Everything the app reads with System.getenv, plus REDIS_PASSWORD, which is
# also what redis-prod enforces with --requirepass. One value, one place.
#
# Managed from the admin UI (Apps -> app -> prod -> Environment), or on the
# box with:  app-env set KEY=VALUE prod
#
# Owned by stacks/app.yml and refused here: KTOR_ENV, REDIS_HOST, REDIS_PORT.

MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/appdb?retryWrites=true&w=majority
REDIS_PASSWORD=REPLACE_ME_LONG_RANDOM

LOG_LEVEL=INFO
