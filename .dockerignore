# The autoscaler and dispatcher images build from the REPOSITORY ROOT, because
# they share signals/. Without this every build ships the git history and the
# panel's 400KB preview artefact into the daemon for no reason.
.git
.idea
.claude
admin/preview
**/__pycache__
**/*.pyc
docs

# The workflow that publishes the images. Nothing in the build needs it.
.github
